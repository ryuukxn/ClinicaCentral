<Window x:Class="ClinicaCentral.register_form"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Patient Registration"
        Width="1200" Height="860" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="#8DBDF2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>

        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="48"/>
        </Style>

        <Style x:Key="HintBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="#888888"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatDate" TargetType="DatePicker">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlatCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,16,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0" MaxHeight="200"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Foreground" Value="#3A6BC4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="18" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B5FD0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#234FB0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C418F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="#2B5FD0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#2B5FD0"
                                BorderThickness="2" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintPassword" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="ClinicaCentral_Logo.png" Width="340" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,6"/>
            <TextBlock HorizontalAlignment="Center" FontSize="48" FontWeight="Bold">
                <Run Text="Clinica" Foreground="White"/><Run Text="Central" Foreground="#3A6BC4"/>
            </TextBlock>
            <TextBlock Text="Your Health, Our Priority." HorizontalAlignment="Center"
                       Foreground="#EAF3FF" FontSize="18"/>
        </StackPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="30,0,0,30" Margin="0,24,0,24" Padding="44,10,44,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,22">
                        <TextBlock Text="REGISTRATION" FontSize="32" FontWeight="ExtraBold" Foreground="#111111"/>
                        <Border Height="4" Background="#2B5FD0" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <TextBox x:Name="txtUsername" Style="{StaticResource HintBox}" Tag="Enter Username"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <Grid>
                                    <PasswordBox x:Name="txtPassword" Style="{StaticResource HintPassword}"
                                                 PasswordChanged="Password_Changed"/>
                                    <TextBlock x:Name="hintPassword" Text="Enter Password" Style="{StaticResource OverlayHint}"
                                               Visibility="Visible"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <TextBox x:Name="txtFullName" Style="{StaticResource HintBox}" Tag="Enter Fullname"/>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Birthdate" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <Grid>
                                    <DatePicker x:Name="dpBirth" Style="{StaticResource FlatDate}"/>
                                    <TextBlock Text="mm/dd/yyyy">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource OverlayHint}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDate, ElementName=dpBirth}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sex" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <ComboBox x:Name="cmbGender" Style="{StaticResource FlatCombo}">
                                    <ComboBoxItem Content="Male"/>
                                    <ComboBoxItem Content="Female"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email Address" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <TextBox x:Name="txtEmail" Style="{StaticResource HintBox}" Tag="Enter Email address"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contact Number" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <TextBox x:Name="txtContact" Style="{StaticResource HintBox}" Tag="Enter Contact Number"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <TextBox x:Name="txtAddress" Style="{StaticResource HintBox}" Tag="Enter Complete Address"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Allergies ( if any)" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <TextBox x:Name="txtAllergies" Style="{StaticResource HintBox}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="120" Height="48" Margin="0,0,16,0" Click="Cancel_Click"/>
                        <Button x:Name="btnRegister" Content="Register" Style="{StaticResource PrimaryButton}"
                                    Width="150" Height="48" Click="Register_Click"/>  
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
