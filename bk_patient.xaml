<Window x:Class="ClinicaCentral.bk_patient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Book Appointment"
        Height="760" Width="1200" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#E8E8E8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="Foreground" Value="#3B6FCB"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Scheduled">
                    <Setter Property="Foreground" Value="#3B6FCB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#2E9E4F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#EEF3FA"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>

        <Style x:Key="SlotButton" TargetType="RadioButton">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,12,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#F0F0F0" BorderBrush="#A8A8A8" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BBDDFB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B8BEB"/>
                                <Setter Property="Foreground" Value="#1E5FBF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2F6BDF" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2457B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#777" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF3FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="24,34,20,34" FontSize="26" Foreground="White">
                    <Run Text="Clinica"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="0,0,0,18" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Width="28"/>
                        <TextBlock Text="Log Out"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="#00AEEF" Foreground="White" Tag="Book Appointment" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="Book Appointment" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="My Appointment" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="My Appointment"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Profile" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28"/>
                            <TextBlock Text="Profile"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>

                <Grid>
                <Rectangle Fill="#8C4A7BC8"/>
                <StackPanel VerticalAlignment="Center" Margin="32,0">
                    <TextBlock x:Name="WelcomeText" Text="Welcome back!"
                               FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="Overview of your activities for today"
                               FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="28,20,28,20" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,22,40,24">

                        <TextBlock Text="BOOK APPOINTMENT" FontFamily="{StaticResource TitleFont}"
                                   FontSize="24" FontWeight="Bold"/>

                        <TextBlock Text="Select Doctor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DoctorBox" Width="520" Height="38" FontSize="15"
                                  HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                  SelectionChanged="DoctorBox_SelectionChanged"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="DateBox" Width="360" Height="38" FontSize="15"
                                            VerticalContentAlignment="Center"
                                            SelectedDateChanged="DateBox_SelectedDateChanged"/>
                            </StackPanel>
                            <StackPanel Margin="30,0,0,0">
                                <TextBlock Text="Time" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="TimeBox" Width="220" Height="38" FontSize="15"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="TimeBox_SelectionChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#F2F2F2" CornerRadius="6" Padding="18,14,18,6"
                                Margin="0,18,0,0" HorizontalAlignment="Left" Width="720">
                            <StackPanel>
                                <TextBlock Text="Available Time Slots" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="SlotHint" Text="" Foreground="#777" FontSize="14" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="SlotPanel"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Reason / Notes (Optional)" FontSize="18" FontWeight="SemiBold" Margin="2,18,0,6"/>
                        <Grid Width="720" HorizontalAlignment="Left">
                            <TextBox x:Name="NotesBox" Height="80" FontSize="15" Padding="8,6"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     TextChanged="NotesBox_TextChanged"/>
                            <TextBlock x:Name="NotesHint" Text="e.g. Check up, fever" Foreground="#999" FontSize="15"
                                       Margin="11,8,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="Attach Image (Optional)" FontSize="18" FontWeight="SemiBold" Margin="2,18,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="720">
                            <Border Width="76" Height="76" Background="#EDEDED" BorderBrush="#BBBBBB"
                                    BorderThickness="1" CornerRadius="4" Margin="0,0,14,0">
                                <Grid>
                                    <TextBlock x:Name="UploadPlaceholder" Text="No image" FontSize="12" Foreground="#888"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="UploadPreview" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Width="560">
                                <Button Content="Upload Image" Width="150" Height="38" HorizontalAlignment="Left"
                                        Style="{StaticResource OutlineButton}" Click="UploadImage_Click"/>
                                <TextBlock x:Name="UploadStatus" FontSize="13" Foreground="#777" Margin="2,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="JPG, PNG or BMP. Your doctor will see it in your medical record."/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="720" Margin="0,22,0,0">
                            <Button Content="Cancel" Width="150" Height="42" Style="{StaticResource OutlineButton}" Click="Cancel_Click"/>
                            <Button Content="Book Appointment" Width="190" Height="42" Margin="16,0,0,0"
                                    Style="{StaticResource BlueButton}" Click="Book_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
