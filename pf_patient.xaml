<Window x:Class="ClinicaCentral.pf_patient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - My Profile"
        Height="760" Width="1200" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#E8E8E8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="Foreground" Value="#3B6FCB"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Scheduled">
                    <Setter Property="Foreground" Value="#3B6FCB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#2E9E4F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#EEF3FA"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1F63E0" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#174FB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1F63E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#7BA7F0" BorderThickness="1.5" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF1FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="24,34,20,34" FontSize="26" Foreground="White">
                    <Run Text="Clinica"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="0,0,0,18" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Width="28"/>
                        <TextBlock Text="Log Out"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Book Appointment" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="Book Appointment"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="My Appointment" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="My Appointment"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="#00AEEF" Foreground="White" Tag="Profile" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28"/>
                            <TextBlock Text="Profile" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>

                <Grid>
                <Rectangle Fill="#8C4A7BC8"/>
                <StackPanel VerticalAlignment="Center" Margin="32,0">
                    <TextBlock x:Name="WelcomeText" Text="Welcome back!"
                               FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="Overview of your activities for today"
                               FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="28,20,28,20" Padding="0">
                <DockPanel Margin="26,20,26,20">

                    <TextBlock DockPanel.Dock="Top" Text="MY PROFILE" FontFamily="{StaticResource TitleFont}"
                               FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EEEEEE" BorderBrush="#CFCFCF" BorderThickness="1"
                                CornerRadius="6" Padding="16,22">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="150" Height="150" HorizontalAlignment="Center">
                                    <Ellipse Fill="#0B0B0B"/>
                                    <TextBlock x:Name="AvatarGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="88" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="PhotoCircle" Visibility="Collapsed"/>
                                </Grid>

                                <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="Bold" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding PatientCode}" FontSize="14" TextAlignment="Center" Margin="0,6,0,0"/>

                                <Border CornerRadius="14" Padding="24,4" HorizontalAlignment="Center" Margin="0,16,0,0" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#B9E8A5"/>
                                            <Setter Property="BorderBrush" Value="#6DBE4F"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                    <Setter Property="Background" Value="#F9C6C6"/>
                                                    <Setter Property="BorderBrush" Value="#E57373"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                </Border>

                                <TextBlock Text="{Binding MemberSinceText}" FontSize="14" TextAlignment="Center" Margin="0,16,0,0"/>

                                <Button x:Name="UploadButton" Content="Upload Photo" Width="150" Height="36" Margin="0,16,0,0"
                                        Style="{StaticResource OutlineButton}" Click="UploadPhoto_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">

                                <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="Personal Information" Style="{StaticResource SectionHeading}"/>
                                    <Border Height="3" Background="#3B6FCB" Margin="0,3,0,0"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding FullName}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding GenderText}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Birthdate" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding BirthdateText}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Contact Number" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding ContactText}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding EmailText}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Allergies" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding AllergiesText}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Complete Address" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding AddressText}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel HorizontalAlignment="Left" Margin="0,8,0,10">
                                    <TextBlock Text="Account" Style="{StaticResource SectionHeading}"/>
                                    <Border Height="3" Background="#3B6FCB" Margin="0,3,0,0"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding Username}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FieldBox}"><TextBlock Text="{Binding PasswordText}" Style="{StaticResource FieldValue}"/></Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Change Password" Width="160" Height="38" Style="{StaticResource OutlineButton}" Click="ChangePassword_Click"/>
                                    <Button Content="Edit Profile" Width="120" Height="38" Margin="12,0,0,0" Style="{StaticResource BlueButton}" Click="EditProfile_Click"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
