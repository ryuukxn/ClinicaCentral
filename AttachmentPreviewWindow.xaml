<Window x:Class="ClinicaCentral.AttachmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attachment Preview" Width="900" Height="680"
        MinWidth="480" MinHeight="360" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#242424"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111" CornerRadius="6" Padding="8">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
        </Border>

        <Button Grid.Row="1" Content="Close" Width="110" Height="38"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                Background="#3F6FD0" Foreground="White" BorderThickness="0"
                FontWeight="SemiBold" Cursor="Hand" Click="Close_Click"/>
    </Grid>
</Window>
