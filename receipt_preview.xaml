<Window x:Class="ClinicaCentral.receipt_preview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Preview"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A6BC4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="20,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F58A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="#2B5FD0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#3A6BC4"
                                BorderThickness="1.5" CornerRadius="4" Padding="26,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2433"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Printed">
                    <Setter Property="Background" Value="#DFF5E6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Issued">
                    <Setter Property="Background" Value="#DDE8FB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Printed">
                    <Setter Property="Foreground" Value="#1E8E4E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Issued">
                    <Setter Property="Foreground" Value="#2B5FD0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Receipt Preview" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom"/>
            <TextBlock Text="{Binding Code}" FontSize="14" Foreground="#888888"
                       Margin="22,0,0,4" VerticalAlignment="Bottom"/>
        </StackPanel>

        <Border x:Name="ReceiptCard" Grid.Row="1" Background="White" BorderBrush="#3B8EDB"
                BorderThickness="1" CornerRadius="8" Padding="22,18">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontSize="28">
                    <Run Text="Clinica" Foreground="#222222"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>
                <TextBlock Text="Appointment Receipt" HorizontalAlignment="Center" FontSize="17"
                           FontWeight="SemiBold" Foreground="#6B7A90" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Code}" HorizontalAlignment="Center" FontSize="28"
                           FontWeight="Bold" Foreground="#2B5FD0" Margin="0,6,0,0"/>

                <Border Height="1" Background="#DDDDDD" Margin="0,14,0,10"/>

                <Grid Margin="0,6">
                    <TextBlock Text="Date" Style="{StaticResource RowLabel}"/>
                    <TextBlock Text="{Binding FullDateText}" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Margin="0,6">
                    <TextBlock Text="Patient" Style="{StaticResource RowLabel}"/>
                    <TextBlock Text="{Binding Patient}" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Margin="0,6">
                    <TextBlock Text="Doctor" Style="{StaticResource RowLabel}"/>
                    <TextBlock Text="{Binding DoctorText}" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Margin="0,6">
                    <TextBlock Text="Purpose" Style="{StaticResource RowLabel}"/>
                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource RowValue}"/>
                </Grid>
                <Grid Margin="0,6">
                    <TextBlock Text="Status" Style="{StaticResource RowLabel}"/>
                    <Border Style="{StaticResource StatusBadge}">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                    </Border>
                </Grid>

                <Border Height="1" Background="#DDDDDD" Margin="0,12,0,10"/>

                <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#666666">
                    <Run Text="Issued by: "/><Run Text="{Binding IssuedBy, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="Thank you for choosing ClinicaCentral." HorizontalAlignment="Center"
                           FontSize="14" Foreground="#666666" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Print Receipt" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="Print_Click"/>
            <Button Content="Close" Style="{StaticResource OutlineButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
