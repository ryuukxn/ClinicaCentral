<Window x:Class="ClinicaCentral.mr_staff"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Medical Records"
        Height="760" Width="1200" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#E8E8E8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#3B6FCB" BorderBrush="#2F5FA8" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F5FA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="lbl" Text="{TemplateBinding Content}" TextDecorations="Underline"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2F5FCB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="lbl" Property="Foreground" Value="#1E3F8F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#D3D8DF" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BFC6D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButtonActive" TargetType="Button" BasedOn="{StaticResource PageButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3B6FCB" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="24,34,20,34" FontSize="26" Foreground="White">
                    <Run Text="Clinica"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="0,0,0,18" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Width="28"/>
                        <TextBlock Text="Log Out"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Patient Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28"/>
                            <TextBlock Text="Patient Records"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="#00AEEF" Foreground="White" Tag="Medical Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Width="28"/>
                            <TextBlock Text="Medical Records" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Schedule" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="Schedule"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>
                <Grid>
                    <Rectangle Fill="#8C4A7BC8"/>
                    <StackPanel VerticalAlignment="Center" Margin="32,0">
                        <TextBlock x:Name="WelcomeText" Text="Welcome back, Doctor!"
                                   FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="Overview of your activities for today"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="28,22,28,22">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Medical Records" FontFamily="{StaticResource TitleFont}"
                               FontSize="28" FontWeight="Bold" Margin="0,0,0,14"/>

                    <StackPanel x:Name="PagerPanel" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,14,10,0"/>

                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Bottom" Visibility="Collapsed"
                               Text="No medical records yet." Foreground="#777" Margin="0,10,0,0"/>

                    <Border DockPanel.Dock="Top" Background="#EDEDED" BorderBrush="#CFCFCF" BorderThickness="1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Date" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="1" Text="Patient Name" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="2" Text="Diagnosis" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="3" Text="Action" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RecordList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#CFCFCF" BorderThickness="1,0,1,1" Padding="14,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource Cell}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PatientName}" Style="{StaticResource Cell}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnosis}" Style="{StaticResource Cell}"/>
                                            <Button Grid.Column="3" Content="View" Tag="{Binding Id}"
                                                    Style="{StaticResource LinkButton}" Click="View_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
