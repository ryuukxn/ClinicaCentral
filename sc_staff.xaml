<Window x:Class="ClinicaCentral.sc_staff"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Schedule"
        Height="760" Width="1200" MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#E8E8E8"
        FontFamily="Segoe UI">

<Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ControlTemplate x:Key="AvailabilityCellTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SoftCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E2E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DayHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2F6BDF" CornerRadius="5" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2457B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeclineButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#D93025"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FDE2E2" CornerRadius="5" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9CACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#00AEEF" CornerRadius="5" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0098D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="24,34,20,34" FontSize="26" Foreground="White">
                    <Run Text="Clinica"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="0,0,0,18" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Width="28"/>
                        <TextBlock Text="Log Out"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Patient Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28"/>
                            <TextBlock Text="Patient Records"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Medical Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Width="28"/>
                            <TextBlock Text="Medical Records"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="#00AEEF" Foreground="White" Tag="Schedule" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="Schedule" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>
                <Grid>
                    <Rectangle Fill="#8C4A7BC8"/>
                    <StackPanel VerticalAlignment="Center" Margin="32,0">
                        <TextBlock x:Name="WelcomeText" Text="Welcome back, Doctor!"
                                   FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="Manage your availability and your booking requests"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftCard}">
                        <StackPanel>
                            <TextBlock Text="My Weekly Availability" Style="{StaticResource CardTitle}"/>

                            <Grid x:Name="AvailabilityGrid" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="52"/>
                                    <RowDefinition Height="52"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Mon" Style="{StaticResource DayHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Tue" Style="{StaticResource DayHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Wed" Style="{StaticResource DayHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Thu" Style="{StaticResource DayHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Fri" Style="{StaticResource DayHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="Sat" Style="{StaticResource DayHeader}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Morning" Style="{StaticResource RowName}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Afternoon" Style="{StaticResource RowName}" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Morning 8–12  ·  Afternoon 1–5  ·  Open = patients can book"
                                       FontSize="13" Foreground="#777" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SoftCard}" Margin="0,14,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Booking Requests" Style="{StaticResource CardTitle}"/>
                                <Border Background="#FFF0C2" CornerRadius="12" Padding="12,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="PendingText" Text="0 pending" FontWeight="SemiBold" FontSize="13" Foreground="#B7791F"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="RequestsEmpty" DockPanel.Dock="Top" Visibility="Collapsed"
                                       Text="No pending booking requests." Foreground="#777" Margin="0,8,0,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="RequestList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Patient}" Style="{StaticResource RowName}"/>
                                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource RowSub}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Confirm" Tag="{Binding Id}" Style="{StaticResource ActionButton}" Click="Confirm_Click"/>
                                                        <Button Content="Decline" Tag="{Binding Id}" Margin="6,0,0,0" Style="{StaticResource DeclineButton}" Click="Decline_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SoftCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Time Off" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <Button Content="+ Add" HorizontalAlignment="Right" Style="{StaticResource AddButton}" Click="AddTimeOff_Click"/>
                            </Grid>

                            <TextBlock x:Name="TimeOffEmpty" Visibility="Collapsed"
                                       Text="No time off scheduled." Foreground="#777" Margin="0,6,0,6"/>

                            <ItemsControl x:Name="TimeOffList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource RowName}"/>
                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource RowSub}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="14" Padding="16,6" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF0C2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="On Leave">
                                                                    <Setter Property="Background" Value="#FDE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold" FontSize="14">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#B7791F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="On Leave">
                                                                        <Setter Property="Foreground" Value="#D93025"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SoftCard}" Margin="0,14,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Confirmed Appointments" Style="{StaticResource CardTitle}"/>
                                <Border Background="#D9F7E3" CornerRadius="12" Padding="12,3"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConfirmedCount" Text="0" FontWeight="SemiBold"
                                            FontSize="13" Foreground="#1E9E4B"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="ConfirmedEmpty" DockPanel.Dock="Top" Visibility="Collapsed"
                                    Text="No confirmed appointments." Foreground="#777" Margin="0,8,0,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ConfirmedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Patient}" Style="{StaticResource RowName}"/>
                                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource RowSub}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Complete" Tag="{Binding Id}"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource ActionButton}" Click="Complete_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
</Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="CompletionOverlay" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed"
              Background="#80000000">
            <Border x:Name="CompletionPanel" Style="{StaticResource SoftCard}"
                    Width="760" MaxHeight="700" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650">
                    <StackPanel>
                        <TextBlock Text="Complete Appointment" Style="{StaticResource CardTitle}"
                                   FontSize="24"/>
                        <TextBlock Text="{Binding PatientName}" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,10,0,0"/>
                        <TextBlock FontSize="13" Foreground="#777" Margin="0,2,0,14">
                            <Run Text="Checked by "/>
                            <Run Text="{Binding DoctorName}"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="HealthyRadio" GroupName="CompletionType"
                                         Content="Healthy / Normal" IsChecked="True"
                                         FontSize="14" Margin="0,0,24,0"/>
                            <RadioButton x:Name="NeedsPrescriptionRadio" GroupName="CompletionType"
                                         Content="Not Healthy / Needs Prescription" FontSize="14"/>
                        </StackPanel>

                        <TextBlock Text="Medical Record" Style="{StaticResource CardTitle}" FontSize="17"/>
                        <TextBlock Text="Diagnosis (required)" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                            <TextBox x:Name="DiagnosisInput" Text="Normal / Healthy" MaxLength="150"
                                     BorderThickness="0" Padding="2,6" FontSize="14"/>
                        </Border>

                        <StackPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Blood pressure" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="BpInput" MaxLength="20" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Temperature (°C)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="TemperatureInput" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Pulse" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="PulseInput" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Weight (kg)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="WeightInput" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Notes" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                <TextBox x:Name="NotesInput" MinHeight="52" AcceptsReturn="True"
                                         TextWrapping="Wrap" BorderThickness="0" Padding="2,6"/>
                            </Border>
                            <TextBlock Text="Treatment" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                <TextBox x:Name="TreatmentInput" MinHeight="52" AcceptsReturn="True"
                                         TextWrapping="Wrap" BorderThickness="0" Padding="2,6"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Prescription" Style="{StaticResource CardTitle}" FontSize="17" Margin="0,14,0,0"/>
                        <StackPanel x:Name="PrescriptionFields">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Medicine name (required)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="MedicineInput" MaxLength="100" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Dosage (required)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="DosageInput" MaxLength="50" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Frequency (required)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="FrequencyInput" MaxLength="100" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Duration (required)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                        <TextBox x:Name="DurationInput" MaxLength="50" BorderThickness="0" Padding="2,6"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Prescription notes (optional)" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Border BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                <TextBox x:Name="PrescriptionDescriptionInput" MinHeight="48"
                                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Padding="2,6"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Cancel" Width="100" Margin="0,0,8,0"
                                    Style="{StaticResource DeclineButton}" Click="CancelCompletion_Click"/>
                            <Button Content="Save &amp; Complete" Width="150"
                                    Style="{StaticResource ActionButton}" Click="SaveComplete_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
