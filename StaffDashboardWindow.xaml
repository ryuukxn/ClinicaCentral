<Window x:Class="ClinicaCentral.StaffDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Staff Dashboard"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#E6E6E6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="26,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="34" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActive" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#00AEEF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="26,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="34" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B8EDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111111"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Foreground" Value="#3A6BC4"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="#9A9A9A"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#3B6EC8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F5DB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#3B8EDB" BorderThickness="1"
                                CornerRadius="4" Padding="24,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="14,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#262626">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="26,40,0,36" FontSize="24">
                    <Run Text="Clinica" Foreground="White"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,24">
                    <Button Content="Call Center" Tag="&#xE717;" Style="{StaticResource NavButton}"/>
                    <Button Content="Help"        Tag="&#xE897;" Style="{StaticResource NavButton}"/>
                    <Button Content="Log Out"     Tag="&#xE7E8;" Style="{StaticResource NavButton}"/>
                </StackPanel>

                <StackPanel>
                    <Button Content="Dashboard"       Tag="&#xE80F;" Style="{StaticResource NavButtonActive}"/>
                    <Button Content="Patient Records" Tag="&#xE77B;" Style="{StaticResource NavButton}"/>
                    <Button Content="Schedule"        Tag="&#xE787;" Style="{StaticResource NavButton}"/>
                    <Button Content="Receipts"        Tag="&#xE7C3;" Style="{StaticResource NavButton}"/>
                    <Button Content="Settings"        Tag="&#xE713;" Style="{StaticResource NavButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2F5FA8" Offset="0"/>
                        <GradientStop Color="#5B8FE0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="32,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="lblWelcome" Text="Welcome back, Staff!" FontSize="28"
                               FontWeight="ExtraBold" Foreground="White"/>
                    <TextBlock Text="Overview of your Activities for Today" FontSize="12"
                               FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,26,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,80,0">
                        <StackPanel>
                            <TextBlock Text="Search Patient by ID" FontSize="13" Foreground="#111111"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E4E4E4" CornerRadius="3" Height="34">
                                    <TextBox x:Name="txtSearch" Style="{StaticResource HintBox}" Tag="e.g P-001"/>
                                </Border>
                                <Button x:Name="btnSearch" Grid.Column="1" Content="Search"
                                        Style="{StaticResource BlueButton}" Width="92" Height="34"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Total Patient" FontSize="14"/>
                                <TextBlock x:Name="txtTotalPatients" Text="0" Style="{StaticResource StatNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="In Queue" FontSize="14"/>
                                <TextBlock x:Name="txtInQueue" Text="0" Style="{StaticResource StatNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Pending Lab Result" FontSize="14"/>
                                <TextBlock x:Name="txtPendingLab" Text="0" Style="{StaticResource StatNumber}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="190">
                            <StackPanel>
                                <TextBlock Text="Appointments" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="1" Text="Patient Name" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColHeader}"/>
                                </Grid>
                                <ItemsControl x:Name="AppointmentsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource CellText}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientName}" Style="{StaticResource CellText}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource CellText}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="190">
                            <StackPanel>
                                <TextBlock Text="Patient In Queue" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.6*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="No." Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="1" Text="Patient ID" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource ColHeader}"/>
                                </Grid>
                                <ItemsControl x:Name="QueueList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.6*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding No}" Style="{StaticResource CellText}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientId}" Style="{StaticResource CellText}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource CellText}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="120">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Recent Patients" Style="{StaticResource CardTitle}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="View Patient" Style="{StaticResource ChipButton}"
                                            Background="#E3ECF7" BorderBrush="#9DB6D8" Foreground="#222222"
                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="1" Text="Patient Name" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColHeader}"/>
                                </Grid>
                                <ItemsControl x:Name="RecentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="130"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource CellText}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientName}" Style="{StaticResource CellText}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource CellText}"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <Button Content="Edit" Style="{StaticResource ChipButton}"
                                                                Background="#DCEBFA" BorderBrush="#5B9BDC" Foreground="#222222"/>
                                                        <Button Content="Delete" Style="{StaticResource ChipButton}"
                                                                Background="#FDECEC" BorderBrush="#E05A5A" Foreground="#D43B3B"
                                                                Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1" Content="Print Receipt" Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
