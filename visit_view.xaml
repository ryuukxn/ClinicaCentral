<Window x:Class="ClinicaCentral.visit_view"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visit Summary"
        Width="820" SizeToContent="Height" MaxHeight="880"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2F6BDF" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2457B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="#2F6BDF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#2F6BDF" BorderThickness="1.5" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF1FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCircle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#DDE0E5" CornerRadius="17" Width="34" Height="34">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C9CDD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BodyCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border x:Name="SummaryCard" Background="White" Padding="32,24,32,28">
            <StackPanel>

                <Grid>
                    <TextBlock Text="Visit Summary" FontFamily="{StaticResource TitleFont}"
                               FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCircle}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>

                <Border Background="#F6F6F6" BorderBrush="#9A9A9A" BorderThickness="1" CornerRadius="4"
                        Padding="16,12" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DateLine}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TimeLine}" FontSize="16" FontWeight="SemiBold" Margin="30,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DoctorLine}" FontSize="16" Margin="0,12,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="14" Padding="24,4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E8E8E8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                            <Setter Property="Background" Value="#FFE8A3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                            <Setter Property="Background" Value="#A9DD8F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Scheduled">
                                            <Setter Property="Background" Value="#A9DD8F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                            <Setter Property="Background" Value="#BFD8F7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter Property="Background" Value="#F9C6C6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#555"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                <Setter Property="Foreground" Value="#B7791F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Scheduled">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="Foreground" Value="#1E5FBF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Border BorderBrush="#9A9A9A" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Diagnosis &amp; Doctor's Notes" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DiagnosisLine}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NotesLine}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Prescriptions" FontSize="18" FontWeight="SemiBold" Margin="2,24,0,6"/>

                <Border Background="#A9A9A9" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Medicine" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="1" Text="Dosage" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="2" Text="Frequency" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="3" Text="Duration" Style="{StaticResource HeaderCell}"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Prescriptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#9A9A9A" BorderThickness="1,0,1,1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Medicine}" Style="{StaticResource BodyCell}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dosage}" Style="{StaticResource BodyCell}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Frequency}" Style="{StaticResource BodyCell}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource BodyCell}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="#9A9A9A" BorderThickness="1,0,1,1" Padding="10,10"
                        Visibility="{Binding NoPrescriptions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No prescriptions for this visit." Foreground="#777" FontSize="14"/>
                </Border>

                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFF176" BorderBrush="#F5A623" BorderThickness="2"
                            CornerRadius="4" Padding="14,8" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Visibility="{Binding HasFollowUp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding FollowUpText}" FontSize="15" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel x:Name="ActionPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Download PDF" Width="130" Height="38" Style="{StaticResource BlueButton}" Click="Pdf_Click"/>
                        <Button Content="Print" Width="120" Height="38" Margin="12,0,0,0" Style="{StaticResource OutlineButton}" Click="Print_Click"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
