<Window x:Class="ClinicaCentral.pr_staff"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Patient Records"
        Height="760" Width="1200" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#E8E8E8"
        FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#3B6FCB" BorderBrush="#2F5FA8" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F5FA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="24,34,20,34" FontSize="26" Foreground="White">
                    <Run Text="Clinica"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="0,0,0,18" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Width="28"/>
                        <TextBlock Text="Log Out"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="#00AEEF" Foreground="White" Tag="Patient Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28"/>
                            <TextBlock Text="Patient Records" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Medical Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Width="28"/>
                            <TextBlock Text="Medical Records"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Schedule" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="Schedule"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>
                <Grid>
                    <Rectangle Fill="#8C4A7BC8"/>
                    <StackPanel VerticalAlignment="Center" Margin="32,0">
                        <TextBlock x:Name="WelcomeText" Text="Welcome back, Doctor!"
                                   FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="Overview of your activities for today"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,22,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,10,16,14">
                    <StackPanel>
                        <TextBlock Text="Search patient by ID" FontSize="13" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox x:Name="SearchBox" Height="38" FontSize="14" Padding="10,0"
                                         VerticalContentAlignment="Center" Background="#EDEDED" BorderThickness="0"
                                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                                <TextBlock x:Name="SearchHint" Text="e.g. PCC-0012" Foreground="#9A9A9A" FontSize="14"
                                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>

                            <Button Grid.Column="2" Content="Search" Height="38" Style="{StaticResource BlueButton}" Click="Search_Click"/>
                            <Button Grid.Column="4" Content="Add" Height="38" Style="{StaticResource BlueButton}" Click="Add_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Patient Records" FontFamily="{StaticResource TitleFont}"
                                   FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Patient ID" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="2" Text="Date of Birth" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="3" Text="Last Visit" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="4" Text="Action" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="EmptyText" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                   Text="No patient records yet." Foreground="#777" Margin="0,10,0,0"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PatientList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Code}" Style="{StaticResource Cell}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Cell}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DateOfBirth}" Style="{StaticResource Cell}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding LastVisit}" Style="{StaticResource Cell}"/>
                                                <Button Grid.Column="4" Content="View" Tag="{Binding Id}" Width="68" Padding="0,4"
                                                        HorizontalAlignment="Center" Style="{StaticResource BlueButton}"
                                                        Click="View_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="PatientProfilePanel" Grid.RowSpan="2" Grid.ColumnSpan="2"
              Panel.ZIndex="100" Visibility="Collapsed" Background="#80000000"
              Focusable="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="White" BorderBrush="#4A90E2" BorderThickness="1" CornerRadius="8"
                        Padding="24" Margin="28" MaxWidth="1040" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="PATIENT PROFILE" FontFamily="{StaticResource TitleFont}"
                                   FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8F8F8" BorderBrush="#E2E2E2"
                                    BorderThickness="1" CornerRadius="8" Padding="16,22">
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                        <Ellipse Fill="#0B0B0B"/>
                                        <TextBlock x:Name="PatientAvatarGlyph" FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE77B;" FontSize="82" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse x:Name="PatientPhotoCircle" Visibility="Collapsed"/>
                                    </Grid>

                                    <TextBlock Text="{Binding FullName}" FontSize="19" FontWeight="Bold"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                    <TextBlock Text="{Binding PatientCode}" FontSize="14"
                                               TextAlignment="Center" Margin="0,6,0,0"/>

                                    <Border CornerRadius="14" Padding="24,4" HorizontalAlignment="Center"
                                            Margin="0,16,0,0" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#B9E8A5"/>
                                                <Setter Property="BorderBrush" Value="#6DBE4F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                        <Setter Property="Background" Value="#F9C6C6"/>
                                                        <Setter Property="BorderBrush" Value="#E57373"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="-">
                                                        <Setter Property="Background" Value="#E2E2E2"/>
                                                        <Setter Property="BorderBrush" Value="#BDBDBD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                            <Setter Property="Foreground" Value="#D93025"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="-">
                                                            <Setter Property="Foreground" Value="#666666"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="{Binding MemberSinceText}" FontSize="14"
                                               TextAlignment="Center" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E2E2"
                                    BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="Personal Information" FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <Border Height="3" Background="#3B6FCB" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Full Name" FontSize="14" Margin="2,0,0,3"/>
                                            <Border Background="#F2F2F2" CornerRadius="6" Padding="12,9"
                                                    MinHeight="40" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding FullName}" FontSize="14" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Gender" FontSize="14" Margin="2,0,0,3"/>
                                            <Border Background="#F2F2F2" CornerRadius="6" Padding="12,9"
                                                    MinHeight="40" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Gender}" FontSize="14" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Text="Birthdate" FontSize="14" Margin="2,0,0,3"/>
                                            <Border Background="#F2F2F2" CornerRadius="6" Padding="12,9"
                                                    MinHeight="40" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding BirthDateText}" FontSize="14"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="Contact Number" FontSize="14" Margin="2,0,0,3"/>
                                            <Border Background="#F2F2F2" CornerRadius="6" Padding="12,9"
                                                    MinHeight="40" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding ContactNumber}" FontSize="14" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Email" FontSize="14" Margin="2,0,0,3"/>
                                            <Border Background="#F2F2F2" CornerRadius="6" Padding="12,9"
                                                    MinHeight="40" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Email}" FontSize="14" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Allergies" FontSize="14" Margin="2,0,0,3"/>
                                            <Border Background="#F2F2F2" CornerRadius="6" Padding="12,9"
                                                    MinHeight="40" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Allergies}" FontSize="14" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                            <TextBlock Text="Complete Address" FontSize="14" Margin="2,0,0,3"/>
                                            <Border Background="#F2F2F2" CornerRadius="6" Padding="12,9"
                                                    MinHeight="40">
                                                <TextBlock Text="{Binding Address}" FontSize="14" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Content="Close" Width="120" Height="38" Margin="0,18,0,0"
                                HorizontalAlignment="Right" Style="{StaticResource BlueButton}"
                                Click="ClosePatientProfile_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
