<Window x:Class="ClinicaCentral.dashboard_staff"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Staff Dashboard"
        Height="760" Width="1200" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#E8E8E8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="Foreground" Value="#3B6FCB"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Scheduled">
                    <Setter Property="Foreground" Value="#3B6FCB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#2E9E4F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#EEF3FA"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="24,34,20,34" FontSize="26" Foreground="White">
                    <Run Text="Clinica"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="0,0,0,18" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Width="28"/>
                        <TextBlock Text="Log Out"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Background="#00AEEF" Foreground="White" Tag="Dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28"/>
                            <TextBlock Text="Dashboard" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Patient Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28"/>
                            <TextBlock Text="Patient Records"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Medical Records" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Width="28"/>
                            <TextBlock Text="Medical Records"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Schedule" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="Schedule"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>

                <Grid>
                <Rectangle Fill="#8C4A7BC8"/>
                <StackPanel VerticalAlignment="Center" Margin="32,0">
                    <TextBlock x:Name="WelcomeText" Text="Welcome back, Doctor!"
                               FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="Overview of your activities for today"
                               FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,22,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total Patients" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="TotalPatientsText" Text="0" Style="{StaticResource StatNumber}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="In Queue" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="InQueueText" Text="0" Style="{StaticResource StatNumber}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pending Lab Results" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="PendingLabText" Text="0" Style="{StaticResource StatNumber}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Today's Appointments" Style="{StaticResource CardTitle}"/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="Patient Name" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColHeader}"/>
                            </Grid>
                            <TextBlock x:Name="AppointmentsEmpty" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                       Text="No appointments scheduled for today." Foreground="#777" Margin="0,8,0,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AppointmentsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientName}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusCell}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Patient in Queue" Style="{StaticResource CardTitle}"/>
                                <Button DockPanel.Dock="Right" Content="Call Next" Style="{StaticResource PillButton}"
                                        Background="#3B6FCB" Foreground="White" Click="CallNext_Click"/>
                            </DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="No." Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="Patient ID" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource ColHeader}"/>
                            </Grid>
                            <TextBlock x:Name="QueueEmpty" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                       Text="No patients waiting." Foreground="#777" Margin="0,8,0,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="QueueList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding No}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientCode}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Cell}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" MaxHeight="230">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Recent Patients" Style="{StaticResource CardTitle}"/>
                                <Button DockPanel.Dock="Right" Content="View Patient" Style="{StaticResource PillButton}"
                                        Click="ViewPatient_Click"/>
                            </DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="Patient Name" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColHeader}"/>
                            </Grid>
                            <TextBlock x:Name="RecentEmpty" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                       Text="No recent patients yet." Foreground="#777" Margin="0,8,0,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="RecentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientName}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusCell}"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <Button Content="Edit" Tag="{Binding Id}" Style="{StaticResource PillButton}"
                                                                Padding="10,3" Margin="0,0,6,0" Click="EditPatient_Click"/>
                                                        <Button Content="Delete" Tag="{Binding Id}" Style="{StaticResource PillButton}"
                                                                Padding="10,3" Foreground="#D32F2F" BorderBrush="#D32F2F"
                                                                Click="DeletePatient_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Button Grid.Column="2" Content="Print Receipt" VerticalAlignment="Bottom"
                            Style="{StaticResource PillButton}" Background="White" FontSize="13" FontWeight="SemiBold"
                            Padding="22,10" Click="PrintReceipt_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
