<Window x:Class="ClinicaCentral.UpdateAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Update Appointment"
        Height="690" Width="980" MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterOwner" Background="#E8E8E8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>

        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6BDF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderBrush" Value="#777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>

        <Style x:Key="SlotButton" TargetType="RadioButton">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#F0F0F0" BorderBrush="#A8A8A8"
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BBDDFB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B8BEB"/>
                                <Setter Property="Foreground" Value="#1E5FBF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
            </Border.Background>
            <Grid>
                <Rectangle Fill="#8C4A7BC8"/>
                <StackPanel VerticalAlignment="Center" Margin="32,0">
                    <TextBlock Text="UPDATE APPOINTMENT" FontFamily="{StaticResource TitleFont}"
                               FontSize="28" FontWeight="Black" Foreground="White"/>
                    <TextBlock x:Name="PatientWelcome" Text="Update your appointment details"
                               FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#4A90E2" BorderThickness="1"
                CornerRadius="8" Margin="28,20" Padding="30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Change your doctor, date, time, or notes."
                               FontSize="16" Foreground="#555"/>

                    <TextBlock Text="Doctor" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DoctorBox" Width="520" Height="38" FontSize="15"
                              HorizontalAlignment="Left" VerticalContentAlignment="Center"
                              SelectionChanged="DoctorBox_SelectionChanged"/>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateBox" Width="300" Height="38" FontSize="15"
                                        SelectedDateChanged="DateBox_SelectedDateChanged"/>
                        </StackPanel>
                        <StackPanel Margin="24,0,0,0">
                            <TextBlock Text="Time" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TimeBox" Width="210" Height="38" FontSize="15"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="TimeBox_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#F2F2F2" CornerRadius="6" Padding="16,12,16,6"
                            Margin="0,16,0,0" HorizontalAlignment="Left" Width="680">
                        <StackPanel>
                            <TextBlock Text="Available Time Slots" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SlotHint" Foreground="#777" FontSize="13"
                                       Text="Choose a doctor and date to see available times."
                                       Margin="0,0,0,8"/>
                            <WrapPanel x:Name="SlotPanel"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Reason / Notes (Optional)" FontSize="17"
                               FontWeight="SemiBold" Margin="2,16,0,6"/>
                    <TextBox x:Name="NotesBox" Width="680" Height="76" FontSize="15"
                             Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Cancel" MinWidth="130" Height="42"
                                Style="{StaticResource OutlineButton}" Click="Cancel_Click"/>
                        <Button Content="Save Changes" MinWidth="160" Height="42" Margin="14,0,0,0"
                                Style="{StaticResource BlueButton}" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
