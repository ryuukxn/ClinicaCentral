<Window x:Class="ClinicaCentral.backup_admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Backup"
        Width="1280" Height="800" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#E6E6E6"
        FontFamily="Segoe UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="26,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="34" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActive" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#00AEEF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="26,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="34" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B8EDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4A86E8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="22,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6FD6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A9C3EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="4" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7C8BA1"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#222222"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Background" Value="#DFF5E6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Background" Value="#FDE0E0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Foreground" Value="#1E8E4E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#D93025"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashText" TargetType="TextBlock">
            <Setter Property="Text" Value="—"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChoiceBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#262626">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="26,44,0,40" FontSize="26">
                    <Run Text="Clinica" Foreground="White"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,24">
                    <Button Content="Log Out" Tag="&#xE7E8;" Style="{StaticResource NavButton}" Click="LogOut_Click"/>
                </StackPanel>

                <StackPanel>
                    <Button Content="Dashboard"      Tag="&#xE80F;" Style="{StaticResource NavButton}" Click="Dashboard_Click"/>
                    <Button Content="Manage Account" Tag="&#xE77B;" Style="{StaticResource NavButton}" Click="ManageAccount_Click"/>
                    <Button Content="Appointments"   Tag="&#xE787;" Style="{StaticResource NavButton}" Click="Appointments_Click"/>
                    <Button Content="Medical Records" Tag="&#xE8A5;" Style="{StaticResource NavButton}" Click="MedicalRecords_Click"/>
                    <Button Content="Patient Records" Tag="&#xE77B;" Style="{StaticResource NavButton}" Click="PatientRecords_Click"/>
                    <Button Content="Receipts"       Tag="&#xE7C3;" Style="{StaticResource NavButton}" Click="Receipts_Click"/>
                    <Button Content="Backup"         Tag="&#xE895;" Style="{StaticResource NavButtonActive}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill"
                                AlignmentX="Center" AlignmentY="Center"/>
                </Border.Background>
                <Grid>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#B02F5FA8" Offset="0"/>
                                <GradientStop Color="#702F5FA8" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Margin="32,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblWelcome" Text="Welcome back!" FontSize="30"
                                   FontWeight="ExtraBold" Foreground="White"/>
                        <TextBlock Text="Overview of your Activities for Today" FontSize="12"
                                   FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,28,30,28">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Last Backup" FontSize="22" FontWeight="ExtraBold"/>
                                    <Border x:Name="LastBadge" Background="#DFF5E6" CornerRadius="11" Padding="16,3"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <TextBlock Text="Success" FontSize="13" FontWeight="Bold"
                                                   Foreground="#1E8E4E"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Date" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
                                <TextBlock x:Name="LastDateText" Text="No backups yet"
                                           Style="{StaticResource FieldValue}"/>

                                <TextBlock Text="Size" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                                <TextBlock x:Name="LastSizeText" Text="—" Style="{StaticResource FieldValue}"/>

                                <Button x:Name="BackupNowButton" Content="Back Up Now"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,20,0,0"
                                        Click="BackupNow_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Automatic Backup" FontSize="22" FontWeight="ExtraBold"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Frequency" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="FrequencyBox" Width="130" Margin="0,4,0,0"
                                                  Style="{StaticResource ChoiceBox}"
                                                  SelectionChanged="Settings_Changed"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Time" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="TimeBox" Width="130" Margin="0,4,0,0"
                                                  Style="{StaticResource ChoiceBox}"
                                                  SelectionChanged="Settings_Changed"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Next backup:" Style="{StaticResource FieldLabel}" Margin="0,20,0,0"/>
                                <TextBlock x:Name="NextBackupText" Text="—" Style="{StaticResource FieldValue}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Deleted Medical Records" FontSize="22" FontWeight="ExtraBold"/>
                            <TextBlock Text="Medical records that were deleted can be reviewed or managed here."
                                       FontSize="13" Foreground="#777777" Margin="0,4,0,0"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Patient"      Style="{StaticResource ColumnHeader}"/>
                                <TextBlock Grid.Column="1" Text="Deleted By"   Style="{StaticResource ColumnHeader}"/>
                                <TextBlock Grid.Column="2" Text="Date Deleted" Style="{StaticResource ColumnHeader}"/>
                                <TextBlock Grid.Column="3" Text="Action"       Style="{StaticResource ColumnHeader}"/>
                            </Grid>

                            <Border BorderBrush="#E3E3E3" BorderThickness="0,1,0,0" Margin="0,8,0,0">
                                <Grid>
                                    <ItemsControl x:Name="DeletedList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="2.4*"/>
                                                            <ColumnDefinition Width="1.6*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Patient}" FontSize="15"
                                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DeletedBy}" FontSize="15"
                                                                   Foreground="#555555" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DeletedText}" FontSize="15"
                                                                   Foreground="#555555" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3" Content="Restore" Tag="{Binding}"
                                                                Style="{StaticResource OutlineButton}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Click="RestorePatient_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="EmptyDeletedText"
                                               Text="No deleted medical records."
                                               FontSize="14" Foreground="#888888"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,24,0,24" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Backup History" FontSize="22" FontWeight="ExtraBold"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2.6*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date &amp; Time" Style="{StaticResource ColumnHeader}"/>
                                <TextBlock Grid.Column="1" Text="Type"   Style="{StaticResource ColumnHeader}"/>
                                <TextBlock Grid.Column="2" Text="Size"   Style="{StaticResource ColumnHeader}"/>
                                <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource ColumnHeader}"/>
                                <TextBlock Grid.Column="4" Text="Action" Style="{StaticResource ColumnHeader}"/>
                            </Grid>

                            <Border BorderBrush="#E3E3E3" BorderThickness="0,1,0,0" Margin="0,8,0,0">
                                <Grid>
                                    <ItemsControl x:Name="HistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.4*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="2.6*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="15"
                                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding BackupType}" FontSize="15"
                                                                   Foreground="#555555" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="15"
                                                                   Foreground="#555555" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="3" Style="{StaticResource StatusBadge}">
                                                            <TextBlock Text="{Binding Status}"
                                                                       Style="{StaticResource StatusText}"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="Download" Tag="{Binding}"
                                                                    Style="{StaticResource OutlineButton}"
                                                                    IsEnabled="{Binding CanRestore}"
                                                                    Click="Download_Click"/>
                                                            <Button Content="Restore" Tag="{Binding}"
                                                                    Style="{StaticResource OutlineButton}"
                                                                    IsEnabled="{Binding CanRestore}"
                                                                    ToolTip="Restore is available when the backup succeeded and its file exists."
                                                                    Click="Restore_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="EmptyText"
                                               Text="No backups yet. Click Back Up Now to create one."
                                               FontSize="14" Foreground="#888888"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,30,0,30" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
