<Window x:Class="ClinicaCentral.dashboard_patient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Patient Dashboard"
        Height="760" Width="1200" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#E8E8E8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="TitleFont">Poppins, Segoe UI Black</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="Foreground" Value="#3B6FCB"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Foreground" Value="#B7791F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                    <Setter Property="Foreground" Value="#2F5FCB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Scheduled">
                    <Setter Property="Foreground" Value="#2F5FCB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#2E9E4F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#EEF3FA"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#DDE2EA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="StatTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="EditPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#E6EEF9"/>
            <Setter Property="BorderBrush" Value="#9DB5D9"/>
        </Style>

        <Style x:Key="DeletePill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#FDE2E2"/>
            <Setter Property="BorderBrush" Value="#E57373"/>
            <Setter Property="Foreground" Value="#D93025"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="24,34,20,34" FontSize="26" Foreground="White">
                    <Run Text="Clinica"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="0,0,0,18" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Width="28"/>
                        <TextBlock Text="Log Out"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Background="#00AEEF" Foreground="White" Tag="Dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28"/>
                            <TextBlock Text="Dashboard" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Book Appointment" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="Book Appointment"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="My Appointment" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Width="28"/>
                            <TextBlock Text="My Appointment"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Profile" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28"/>
                            <TextBlock Text="Profile"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <ImageBrush ImageSource="Clinica_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>

                <Grid>
                <Rectangle Fill="#8C4A7BC8"/>
                <StackPanel VerticalAlignment="Center" Margin="32,0">
                    <TextBlock x:Name="WelcomeText" Text="Welcome back!"
                               FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="Overview of your activities for today"
                               FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Next Appointment" Style="{StaticResource StatTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatIcon}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="18" Foreground="#3B6FCB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="NextDateText" Text="None" FontSize="30" FontWeight="SemiBold" Foreground="#3B6FCB"/>
                            </StackPanel>
                            <TextBlock x:Name="NextDoctorText" Text="No upcoming visit" FontSize="14" Margin="46,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Prescriptions" Style="{StaticResource StatTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatIcon}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="18" Foreground="#3B6FCB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="PrescriptionCountText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#3B6FCB"/>
                            </StackPanel>
                            <TextBlock Text=" " FontSize="14" Margin="46,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total Appointments" Style="{StaticResource StatTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatIcon}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="18" Foreground="#3B6FCB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="TotalAppointmentsText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#3B6FCB"/>
                            </StackPanel>
                            <TextBlock Text=" " FontSize="14" Margin="46,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="My Appointments" Style="{StaticResource CardTitle}"/>

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="Time" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Doctor" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource ColHeader}"/>
                            </Grid>

                            <TextBlock x:Name="AppointmentsEmpty" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                       Text="No upcoming appointments." Foreground="#777" Margin="0,8,0,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AppointmentsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding When, StringFormat={}{0:MM/dd/yyyy}}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding When, StringFormat={}{0:h:mm tt}}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DoctorText}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource StatusCell}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Result Condition" Style="{StaticResource CardTitle}" Margin="16,14,0,6"/>

                            <Border x:Name="ConditionBand" DockPanel.Dock="Top" Background="#E8E8E8" Padding="16,6">
                                <TextBlock x:Name="ConditionText" Text="No result yet" FontSize="26" FontWeight="Bold"
                                           Foreground="#777" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock x:Name="ConditionMessage" Text="" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="16,10,16,0"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Prescription" Style="{StaticResource CardTitle}"/>

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="Intake" Style="{StaticResource ColHeader}"/>
                            </Grid>

                            <TextBlock x:Name="PrescriptionEmpty" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                       Text="No active prescriptions." Foreground="#777" Margin="0,8,0,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PrescriptionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Medicine}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Intake}" Style="{StaticResource Cell}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Medical &amp; History" Style="{StaticResource CardTitle}"/>

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="Doctor" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Diagnosis" Style="{StaticResource ColHeader}"/>
                            </Grid>

                            <TextBlock x:Name="HistoryEmpty" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                       Text="No medical history yet." Foreground="#777" Margin="0,8,0,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding RecordDate, StringFormat={}{0:MM/dd/yyyy}}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DoctorText}" Style="{StaticResource Cell}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DiagnosisText}" Style="{StaticResource Cell}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
